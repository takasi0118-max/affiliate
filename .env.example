# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Rakuten API
RAKUTEN_APPLICATION_ID=your_rakuten_application_id
RAKUTEN_ACCESS_KEY=your_rakuten_access_key
RAKUTEN_AFFILIATE_ID=your_rakuten_affiliate_id

# WordPress
WORDPRESS_URL=https://example.com
WORDPRESS_USERNAME=your_wordpress_username
WORDPRESS_APP_PASSWORD=your_wordpress_application_password

# Site
SITE_KEY=disaster
OUTPUT_DIR=sites/disaster/output

# App
LOG_LEVEL=INFO
